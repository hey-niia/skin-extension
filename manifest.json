{
  "manifest_version": 3,
  "name": "Skin",
  "version": "0.4.0",
  "description": "A paper skin for Claude and ChatGPT: your chats sorted into folders you style yourself. Everything stays in your browser.",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/grain.png",
        "assets/fiber.png",
        "fonts/spline-sans-mono.woff2",
        "fonts/instrument-sans.woff2"
      ],
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*"
      ]
    }
  ]
}
